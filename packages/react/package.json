{
	"name": "xlsx-react-viewer",
	"version": "0.1.0",
	"description": "xlsx-viewer for React: an Excel viewer and editor component to open, edit, calculate and save .xlsx workbooks in the browser.",
	"keywords": [
		"excel",
		"xlsx",
		"spreadsheet",
		"react",
		"react-component",
		"viewer",
		"editor",
		"grid"
	],
	"homepage": "https://github.com/SEMOSS/excel-viewer/tree/main/packages/react#readme",
	"bugs": {
		"url": "https://github.com/SEMOSS/excel-viewer/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SEMOSS/excel-viewer.git",
		"directory": "packages/react"
	},
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles": "./dist/xlsx-viewer.css",
		"./styles.css": "./dist/xlsx-viewer.css",
		"./theme.css": "./src/styles/theme.css"
	},
	"files": [
		"dist/",
		"src/styles/theme.css",
		"README.md"
	],
	"scripts": {
		"build": "vite build && tsc -p tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"lucide-react": "^0.577.0",
		"xlsx-viewer-core": "workspace:*"
	},
	"peerDependencies": {
		"react": "^18.2.0 || ^19.0.0",
		"react-dom": "^18.2.0 || ^19.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.2.4",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.3.0",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.1.0",
		"jsdom": "22.1.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "4.2.4",
		"typescript": "~5.9.3",
		"vite": "~7.3.3",
		"vitest": "^4.1.0"
	}
}
