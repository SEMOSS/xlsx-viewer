{
	"name": "xlsx-viewer-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "pnpm --filter xlsx-viewer-core build && pnpm --filter xlsx-react-viewer build && pnpm --filter xlsx-react-demo build",
		"demo": "pnpm --filter xlsx-react-demo dev",
		"demo:build": "pnpm --filter xlsx-react-demo build",
		"test": "pnpm --filter xlsx-viewer-core test && pnpm --filter xlsx-react-viewer test",
		"e2e": "playwright test",
		"e2e:headed": "playwright test --headed",
		"e2e:ui": "playwright test --ui",
		"typecheck": "pnpm -r --parallel typecheck && tsc --noEmit -p e2e/tsconfig.json",
		"fmt": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\" \"demos/*/src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" playwright.config.ts",
		"fmt:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css}\" \"demos/*/src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" playwright.config.ts"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"playwright": "1.57.0",
		"prettier": "^3.8.0",
		"typescript": "~5.9.3",
		"vitest": "^4.1.0"
	},
	"pnpm": {
		"overrides": {
			"electron-to-chromium": "1.5.364",
			"@types/react-dom": "19.2.5",
			"@types/node": "24.12.4",
			"obug": "2.1.2",
			"nwsapi": "2.2.22",
			"form-data": "4.0.5",
			"@tootallnate/once": "2.0.0",
			"vite": "7.3.3",
			"iconv-lite": "0.7.2"
		},
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
